<?xml version="1.0" encoding="UTF-8"?>
<!-- Dateityp für geteilte Lion-Launcher-Profile (.lion), Flatpak-Variante.
     Flatpak exportiert nur Icons mit App-ID-Präfix, daher wird das App-Icon genutzt.
     Installiert nach /app/share/mime/packages/com.lionlauncher.dev.xml. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-lion-profile">
    <comment>Lion Launcher profile</comment>
    <comment xml:lang="de">Lion-Launcher-Profil</comment>
    <sub-class-of type="application/json"/>
    <icon name="com.lionlauncher.dev"/>
    <glob pattern="*.lion"/>
  </mime-type>
</mime-info>
