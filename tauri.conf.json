{
  "productName": "Lion Launcher",
  "version": "0.1.0",
  "identifier": "com.lionlauncher.dev",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lion Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Game",
    "fileAssociations": [
      {
        "ext": ["lion"],
        "name": "Lion Profile",
        "description": "Lion Launcher Profil",
        "role": "Editor",
        "mimeType": "application/x-lion-profile",
        "exportedType": {
          "identifier": "com.lionlauncher.dev.profile",
          "conformsTo": ["public.json"]
        }
      }
    ],
    "shortDescription": "Ein moderner Minecraft Launcher",
    "longDescription": "Lion Launcher ist ein moderner, schneller Minecraft Launcher mit Unterstützung für Fabric, Quilt, Forge und NeoForge. Er bietet eine intuitive Benutzeroberfläche, einfache Mod-Installation und umfassende Profilverwaltung.",
    "publisher": "Thorben Hess",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["libgtk-3-0", "libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"],
        "section": "games",
        "priority": "optional",
        "desktopTemplate": "pkg/linux/lion-launcher.desktop.hbs",
        "files": {
          "/usr/share/mime/packages/lion-launcher.xml": "pkg/linux/lion-launcher-mime.xml",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-lion-profile.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-lion-profile.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-lion-profile.png": "icons/128x128@2x.png"
        }
      },
      "rpm": {
        "release": "1",
        "epoch": 0,
        "desktopTemplate": "pkg/linux/lion-launcher.desktop.hbs",
        "files": {
          "/usr/share/mime/packages/lion-launcher.xml": "pkg/linux/lion-launcher-mime.xml",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-lion-profile.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-lion-profile.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-lion-profile.png": "icons/128x128@2x.png"
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["German", "English"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/icon.png"
      },
      "wix": null
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    }
  }
}
